/dts-v1/;

/ {
	compatible = "amlogic, s7d";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	coreelec;
	model = "Xiaomi 3rd Gen";
	coreelec-dt-id = "s7d_s905x5m_xiaomi_3rd_gen";

	ir_wakeup_key {
		key_num = <0x0b>;
		wakeup_key = <0xba45bd02 0x00 0x74 0xef10fe01 0x00 0x74 0xef10fb04 0x00 0x74 0xf20dfe01 0x00 0x74 0xe51afb04 0x00 0x74 0xde217788 0x00 0x74 0x3ac5bd02 0x01 0x85 0xb8477788 0x00 0x66 0x9b647788 0x00 0xbc 0x8f707788 0x00 0x1de 0x9c637788 0x00 0xbb>;
	};

	valhall {
		compatible = "arm,mali-valhall-csf";
		#cooling-cells = <0x02>;
		reg = <0x00 0xfd000000 0x00 0x800000 0x00 0xfe002000 0x00 0x1000>;
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x90 0x04 0x00 0x91 0x04 0x00 0x92 0x04>;
		interrupt-names = "GPU", "MMU", "JOB";
		num_of_pp = <0x01>;
		sc_mpp = <0x01>;
		def_clk = <0x00>;
		tbl = <0x02 0x03 0x04 0x05 0x06 0x06>;
		status = "okay";
		operating-points-v2 = <0x07>;
		system-coherency = <0x1f>;
		clocks = <0x08 0x71 0x08 0x78>;
		clock-names = "gpu_mux", "gpu_stack";
		assigned-clocks = <0x08 0x6b 0x08 0x6d 0x08 0x71 0x08 0x72 0x08 0x74 0x08 0x78>;
		assigned-clock-parents = <0x08 0x07 0x00 0x08 0x6d 0x08 0x07 0x00 0x08 0x74>;
		assigned-clock-rates = <0x00 0x17d78400 0x00 0x00 0x17d78400 0x00>;
		phandle = <0x67>;

		clk125_cfg {
			clk_freq = <0x7735940>;
			clk_parent = "fclk_div4";
			clkp_freq = <0x1dcd6500>;
			clk_reg = <0xa03>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x1e 0x78>;
		};

		dvfs250_cfg {
			clk_freq = <0xee6b280>;
			clk_parent = "fclk_div4";
			clkp_freq = <0x1dcd6500>;
			clk_reg = <0xa01>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x00 0x4c>;
		};

		dvfs285_cfg {
			clk_freq = <0x1107a76d>;
			clk_parent = "fclk_div7";
			clkp_freq = <0x1107a76d>;
			clk_reg = <0xe00>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x00 0x4c>;
			phandle = <0x02>;
		};

		dvfs400_cfg {
			clk_freq = <0x17d78400>;
			clk_parent = "fclk_div5";
			clkp_freq = <0x17d78400>;
			clk_reg = <0xc00>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x50 0x78>;
			phandle = <0x03>;
		};

		dvfs500_cfg {
			clk_freq = <0x1dcd6500>;
			clk_parent = "fclk_div4";
			clkp_freq = <0x1dcd6500>;
			clk_reg = <0xa00>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x50 0x78>;
			phandle = <0x04>;
		};

		dvfs666_cfg {
			clk_freq = <0x27bc86aa>;
			clk_parent = "fclk_div3";
			clkp_freq = <0x27bc86aa>;
			clk_reg = <0x800>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x50 0x78>;
			phandle = <0x05>;
		};

		dvfs800_cfg {
			clk_freq = <0x2faf0800>;
			clk_parent = "fclk_div2p5";
			clkp_freq = <0x2faf0800>;
			clk_reg = <0x600>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x50 0xff>;
			phandle = <0x06>;
		};

		dvfs830_cfg {
			clk_freq = <0x3178cb80>;
			clk_parent = "sys2_pll";
			clkp_freq = <0x3178cb80>;
			clk_reg = <0x200>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x50 0xff>;
		};

		dvfs828_cfg {
			clk_freq = "1ZG";
			clk_parent = "sys2_pll";
			clkp_freq = "1ZG";
			clk_reg = <0x200>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x50 0xff>;
		};

		dvfs852_cfg {
			clk_freq = <0x32c87d00>;
			clk_parent = "sys2_pll";
			clkp_freq = <0x32c87d00>;
			clk_reg = <0x200>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x50 0xff>;
		};

		dvfs996_cfg {
			clk_freq = <0x3b5dc100>;
			clk_parent = "gp1_pll";
			clkp_freq = <0x3b5dc100>;
			clk_reg = <0x200>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x50 0xff>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55", "arm,armv8";
			reg = <0x00 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x09 0x0a>;
			dynamic-power-coefficient = <0xe6>;
			#cooling-cells = <0x02>;
			operating-points-v2 = <0x0b 0x0c 0x0d 0x0e>;
			phandle = <0x66>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a55", "arm,armv8";
			reg = <0x00 0x100>;
			enable-method = "psci";
			cpu-idle-states = <0x09 0x0a>;
			dynamic-power-coefficient = <0xe6>;
			#cooling-cells = <0x02>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a55", "arm,armv8";
			reg = <0x00 0x200>;
			enable-method = "psci";
			cpu-idle-states = <0x09 0x0a>;
			dynamic-power-coefficient = <0xe6>;
			#cooling-cells = <0x02>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a55", "arm,armv8";
			reg = <0x00 0x300>;
			enable-method = "psci";
			cpu-idle-states = <0x09 0x0a>;
			dynamic-power-coefficient = <0xe6>;
			#cooling-cells = <0x02>;
		};

		idle-states {
			entry-method = "arm,psci-0.2";

			cpu-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x5a4>;
				exit-latency-us = <0x2a3>;
				min-residency-us = <0xa4e>;
				phandle = <0x09>;
			};

			system-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x00>;
				entry-latency-us = <0x3fffffff>;
				exit-latency-us = <0x40000000>;
				min-residency-us = <0xffffffff>;
				phandle = <0x0a>;
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xff08 0x01 0x0e 0xff08 0x01 0x0b 0xff08 0x01 0x0a 0xff08>;
	};

	timer_bc {
		compatible = "amlogic,bc-timer";
		status = "disabled";
		reg = <0x00 0xfe0100d8 0x00 0x04 0x00 0xfe0100dc 0x00 0x04>;
		timer_name = "Meson TimerD";
		clockevent-rating = <0x12c>;
		clockevent-shift = <0x14>;
		clockevent-features = <0x23>;
		interrupts = <0x00 0x03 0x01>;
		bit_enable = <0x07>;
		bit_mode = <0x06>;
		bit_resolution = <0x00>;
		resolution_1us = <0x01>;
		min_delta_ns = <0x0a>;
	};

	arm_pmu {
		compatible = "arm,armv8-pmuv3";
		private-interrupts;
		interrupts = <0x00 0xeb 0x04 0x00 0xec 0x04 0x00 0xed 0x04 0x00 0xee 0x04>;
	};

	interrupt-controller@fff01000 {
		compatible = "arm,cortex-a15-gic", "arm,cortex-a9-gic";
		#interrupt-cells = <0x03>;
		#address-cells = <0x00>;
		interrupt-controller;
		reg = <0x00 0xfff01000 0x00 0x1000 0x00 0xfff02000 0x00 0x100>;
		interrupts = <0x01 0x09 0xf04>;
		phandle = <0x01>;
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	pm {
		compatible = "amlogic, pm";
		status = "okay";
		device_name = "aml_pm";
		extend_resume_reason;
		clear_suspend_reason = <0x09>;
		reg = <0x00 0xfe010288 0x00 0x04 0x00 0xfe0102dc 0x00 0x04>;
	};

	cpu_info {
		compatible = "amlogic, cpuinfo";
		status = "okay";
		cpuinfo_cmd = <0x82000044>;
	};

	soc_info {
		compatible = "amlogic, socdata";
		reg = <0x00 0xfe010000 0x00 0x0c 0x00 0xfe010180 0x00 0x04>;
		read_nocsdata_cmd = <0x82000039>;
		write_nocsdata_cmd = <0x82000038>;
		auth_reg_ops_cmd = <0x820000f0>;
	};

	aml_reboot {
		compatible = "aml, reboot";
		sys_reset = <0x84000009>;
		sys_poweroff = <0x84000008>;
		dis_nb_cpus_in_shutdown;
		extend_reboot_reason;
		reg = <0x00 0xfe01037c 0x00 0x04>;
		status = "okay";
	};

	ram-dump {
		compatible = "amlogic, ram_dump";
		status = "okay";
		reg = <0x00 0xfe0102d8 0x00 0x04>;
		reg-names = "SYSCTRL_STICKY_REG6";
		store_device = "data";
	};

	secmon {
		compatible = "amlogic, secmon";
		memory-region = <0x0f>;
		in_base_func = <0x82000020>;
		out_base_func = <0x82000021>;
		inout_size_func = <0x8200002a>;
		reserve_mem_size = <0x3300000>;
	};

	optee {
		compatible = "linaro,optee-tz";
		method = "smc";
	};

	aml_watermark {
		compatible = "amlogic,watermark";
		soc-name = "s7d";
		interrupts = <0x00 0xc5 0x01>;
		interrupt-names = "wm-vsync";
	};

	cma_shrinker {
		compatible = "amlogic, cma-shrinker";
		status = "disabled";
		adj = <0x00 0x64 0xc8 0xfa 0x384 0x3b6>;
		free = <0x1e00 0x5ee0 0x6f70 0x7f58 0x8000 0x8f10>;
	};

	securitykey {
		compatible = "aml, securitykey";
		storage_query = <0x82000060>;
		storage_read = <0x82000061>;
		storage_write = <0x82000062>;
		storage_tell = <0x82000063>;
		storage_verify = <0x82000064>;
		storage_status = <0x82000065>;
		storage_list = <0x82000067>;
		storage_remove = <0x82000068>;
		storage_in_func = <0x82000023>;
		storage_out_func = <0x82000024>;
		storage_block_func = <0x82000025>;
		storage_size_func = <0x82000027>;
		storage_set_enctype = <0x8200006a>;
		storage_get_enctype = <0x8200006b>;
		storage_version = <0x8200006c>;
	};

	xtal-clk {
		compatible = "fixed-clock";
		clock-frequency = <0x16e3600>;
		clock-output-names = "xtal";
		#clock-cells = <0x00>;
		phandle = <0x14>;
	};

	rtc@0xfe010288 {
		compatible = "amlogic,meson-vrtc";
		reg = <0x00 0xfe010288 0x00 0x04>;
		status = "okay";
		mboxes = <0x10 0x02>;
	};

	power-domains {
		compatible = "amlogic,s7d-power-domain";
		#power-domain-cells = <0x01>;
		status = "okay";
		phandle = <0x37>;
	};

	jtag {
		compatible = "amlogic, jtag";
		status = "disabled";
		select = "disable";
		pinctrl-names = "jtag_a_pins", "jtag_b_pins";
		pinctrl-0 = <0x11>;
		pinctrl-1 = <0x12>;
	};

	mbox_fifo@0xfe006000 {
		status = "okay";
		compatible = "amlogic, s7d-mbox-fifo";
		reg = <0x00 0xfe006000 0x00 0x800 0x00 0xfe006800 0x00 0x800 0x00 0xfe0070c0 0x00 0x40 0x00 0xfe007100 0x00 0x40 0x00 0xfe007140 0x00 0x40 0x00 0xfe007020 0x00 0x40>;
		interrupts = <0x00 0xf8 0x01>;
		mbox-irqctlr = <0x00>;
		mbox-nums = <0x02>;
		mboxids = <0x02 0x03>;
		aocpu_sts_mboxid = <0x04>;
		ree2aocpu_mboxid = <0x03>;
		#mbox-cells = <0x01>;
		phandle = <0x10>;
	};

	mbox_devfs {
		status = "disabled";
		compatible = "amlogic, mbox-devfs";
		mbox-nums = <0x01>;
		mbox-names = "ree2aocpu";
		mboxes = <0x10 0x01>;
		mbox-dests = <0x01>;
	};

	pwm_j-regulator {
		compatible = "pwm-regulator";
		pwms = <0x13 0x00 0x4ec 0x00>;
		regulator-name = "vddcpu0";
		regulator-min-microvolt = <0xa5c58>;
		regulator-max-microvolt = <0xef038>;
		regulator-always-on;
		max-duty-cycle = <0x4ec>;
		amlogic,vsel-step = <0x03>;
		amlogic,usleep-time = <0xc8>;
		voltage-table = <0xef038 0x00 0xec928 0x03 0xea218 0x07 0xe7b08 0x0a 0xe53f8 0x0d 0xe2ce8 0x11 0xe05d8 0x14 0xddec8 0x17 0xdb7b8 0x1b 0xd90a8 0x1e 0xd6998 0x21 0xd4288 0x25 0xd1b78 0x28 0xcf468 0x2b 0xccd58 0x2f 0xca648 0x32 0xc7f38 0x35 0xc5828 0x39 0xc3118 0x3c 0xc0a08 0x3f 0xbe2f8 0x43 0xbbbe8 0x46 0xb94d8 0x49 0xb6dc8 0x4d 0xb46b8 0x50 0xb1fa8 0x53 0xaf898 0x57 0xad188 0x5a 0xaaa78 0x5d 0xa8368 0x61 0xa5c58 0x64>;
		status = "okay";
		phandle = <0x4f>;
	};

	saradc-common@fe026000 {
		compatible = "amlogic,saradc-common";
		reg = <0x00 0xfe026000 0x00 0x84>;

		saradc {
			compatible = "amlogic,saradc", "amlogic,s7d-saradc";
			interrupts = <0x00 0xb5 0x01>;
			clock-names = "src", "core", "gate", "mux";
			clocks = <0x14 0x08 0xee 0x08 0x18 0x08 0x16>;
			#io-channel-cells = <0x01>;
			amlogic,clock-frequency = <0x2dc6c0>;
			amlogic,test-channel = <0x07>;
			amlogic,fifo-data-width = <0x10>;
			amlogic,reg7-init = <0xc11>;
			amlogic,reg8-init = <0x280614d>;
			amlogic,reg3-init = <0x10a02403>;
			amlogic,reg4-init = <0x80>;
			amlogic,reg9-init = <0xf0f0>;
			amlogic,reg10-init = <0x70503010>;
			amlogic,reg11-init = <0xf0d0b090>;
			reset-names = "analog";
			resets = <0x15 0x53>;
			status = "okay";
		};

		pdd {
			compatible = "amlogic,pdd";
			interrupt-controller;
			#interrupt-cells = <0x01>;
			amlogic,interrupt = <0xb6>;
			amlogic,digital-maps = <0x18 0x1a 0x18 0x17 0x18 0x11>;
			amlogic,analog-maps = <0x14 0x1a 0x14 0x16 0x14 0x18>;
			amlogic,voltage-maps = <0x190 0x320 0x320 0x4b0>;
			status = "okay";
		};
	};

	shmem {
		compatible = "mmio-sram";
		reg = <0x00 0x50f6000 0x00 0x100>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x50f6000 0x100>;

		shmem@0 {
			compatible = "arm,scmi-shmem";
			reg = <0x00 0x100>;
			phandle = <0x16>;
		};
	};

	firmware {

		scmi {
			compatible = "arm,scmi-smc";
			arm,smc-id = <0x820000c1>;
			shmem = <0x16>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			protocol@14 {
				reg = <0x14>;
				#clock-cells = <0x01>;
				phandle = <0x17>;
			};
		};

		android {
			compatible = "android,firmware";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot";
				by_name_prefix = "/dev/block";
			};
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		apb4@fe000000 {
			compatible = "simple-bus";
			reg = <0x00 0xfe000000 0x00 0x480000>;
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges = <0x00 0x00 0x00 0xfe000000 0x00 0x480000>;

			clock-controller {
				compatible = "amlogic,s7d-clkc";
				#clock-cells = <0x01>;
				reg = <0x00 0x00 0x00 0x49c 0x00 0x8000 0x00 0x384>;
				reg-names = "basic", "pll";
				clocks = <0x14 0x17 0x04 0x17 0x08 0x17 0x0a 0x17 0x0c 0x17 0x0d 0x17 0x10 0x17 0x11>;
				clock-names = "xtal", "gp0_pll_src", "hifi0_pll_src", "hifi1_pll_src", "sys_clk", "axi_clk", "fixed_pll", "gp1_pll";
				status = "okay";
				phandle = <0x08>;
			};

			meson_clk_msr@48000 {
				compatible = "amlogic,meson-s7d-clk-measure";
				reg = <0x00 0x48000 0x00 0x1c>;
			};

			watchdog@2100 {
				compatible = "amlogic,meson-sc2-wdt";
				status = "okay";
				amlogic,feed_watchdog_mode = <0x00>;
				reg = <0x00 0x2100 0x00 0x10>;
				clocks = <0x14>;
			};

			pinctrl@4000 {
				compatible = "amlogic,meson-s7d-periphs-pinctrl";
				#address-cells = <0x02>;
				#size-cells = <0x02>;
				ranges;
				phandle = <0x18>;

				bank@4000 {
					reg = <0x00 0x4000 0x00 0x4c 0x00 0x40c0 0x00 0x2cc>;
					reg-names = "mux", "gpio";
					gpio-controller;
					#gpio-cells = <0x02>;
					gpio-ranges = <0x18 0x00 0x00 0x54>;
					phandle = <0x1e>;
				};

				i2c0_pins1 {

					mux {
						groups = "i2cm_a_sda_cc1", "i2cm_a_scl_cc2";
						function = "i2cm_a";
						drive-strength = <0x03>;
						bias-disable;
					};
				};

				i2c1_pins1 {

					mux {
						groups = "i2cm_b_sda_c6", "i2cm_b_scl_c7";
						function = "i2cm_b";
						drive-strength = <0x03>;
						bias-disable;
					};
				};

				i2c1_pins2 {

					mux {
						groups = "i2cm_b_sda_dv1", "i2cm_b_scl_dv2";
						function = "i2cm_b";
						drive-strength = <0x03>;
						bias-disable;
					};
				};

				i2c1_pins3 {

					mux {
						groups = "i2cm_b_sda_h6", "i2cm_b_scl_h7";
						function = "i2cm_b";
						drive-strength = <0x03>;
						bias-disable;
					};
				};

				i2c1_pins4 {

					mux {
						groups = "i2cm_b_sda_x17", "i2cm_b_scl_x18";
						function = "i2cm_b";
						drive-strength = <0x03>;
						bias-disable;
					};
				};

				i2c2_pins1 {

					mux {
						groups = "i2cm_c_sda_dv5", "i2cm_c_scl_dv6";
						function = "i2cm_c";
						drive-strength = <0x03>;
						bias-disable;
					};
				};

				i2c2_pins2 {

					mux {
						groups = "i2cm_c_sda_h0", "i2cm_c_scl_h1";
						function = "i2cm_c";
						drive-strength = <0x03>;
						bias-disable;
					};
				};

				i2c2_pins3 {

					mux {
						groups = "i2cm_c_sda_h8", "i2cm_c_scl_h9";
						function = "i2cm_c";
						drive-strength = <0x03>;
						bias-disable;
					};
				};

				i2c3_pins1 {

					mux {
						groups = "i2cm_d_sda_x10", "i2cm_d_scl_x11";
						function = "i2cm_d";
						drive-strength = <0x03>;
						bias-disable;
					};
