	gpioleds {
		compatible = "gpio-leds";
		status = "okay";

		sys_led {
			linux,default-trigger = "default-on";
			label = "sys_led";
			gpios = <0x1e 0x23 0x00>;
		};
	};

	bl30_manager {
		compatible = "coreelec,bl30_manager";
		status = "okay";
		mbox-nums = <0x01>;
		mbox-names = "ree2aocpu";
		mbox-dests = <0x01>;
		mboxes = <0x10 0x01>;
	};

	meson-ir {
		compatible = "amlogic,meson6-ir";
		status = "okay";
		reg = <0x00 0xfe084080 0x00 0xa4>;
		interrupts = <0x00 0x94 0x01>;
		pinctrl-names = "default";
		pinctrl-0 = <0x88>;
		pulse-inverted;
		wakeup_protocol = <0x09>;
	};

	meson-remote {
		compatible = "amlogic, meson-ir";
		status = "okay";
		reg = <0x00 0xfe084080 0x00 0xa4 0x00 0xfe084000 0x00 0x58>;
		interrupts = <0x00 0x94 0x01>;
		pinctrl-names = "default";
		pinctrl-0 = <0x88>;
		protocol = <0x01>;
		max_frame_time = <0xc8>;
		led_blink = <0x01>;
	};

	openvfd {
		compatible = "open,vfd";
