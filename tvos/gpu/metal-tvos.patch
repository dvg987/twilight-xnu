+/// QuartzCore's first pipeline on tvOS 16.5 (CA::OGL::MetalContext::create_fragment_shader for spec "A2Xhf": two attachments,
+/// half precision, framebuffer fetch, no images): fixed_vert_lph_spc with fixed_frag_lph_cph and the constants CA gives them,
+/// fc_color_opcodes0/1 as uchar3. `reserved` is 1 when the pipeline is made, 2 when it is refused (the reason in `message`).
+fn uber(run: &mut Run, device: &Device, library: &metal2vulkan_runtime::Library, names: &[String]) {
+    use metal2vulkan::library::{FunctionConstantValue, FunctionConstantValues};
+    use metal2vulkan::metal::{DataType, VertexFormat};
+    use metal2vulkan::pipeline::{VertexAttributeDescriptor, VertexBufferLayoutDescriptor, VertexDescriptor};
+    let (vname, fname) = ("fixed_vert_lph_spc", "fixed_frag_lph_cph");
+    if !names.iter().any(|n| n == vname) || !names.iter().any(|n| n == fname) {
+        return;
+    }
+    let mut values = FunctionConstantValues::defaults();
+    let mut set = |name: &str, ty: DataType, bytes: &[u8]| {
+        values.by_name.insert(name.to_string(), FunctionConstantValue::new(ty, bytes.to_vec()));
+    };
+    for (name, value) in [("fc_generic", 0), ("fc_framebuffer_fetch", 1), ("fc_framebuffer_sample", 0), ("fc_has_lod_bias", 0),
+                          ("fc_has_noise_scale", 0), ("fc_has_ycbcr_matrix", 0), ("fc_has_gamma_luts", 0), ("fc_has_asg_77_weights", 0),
+                          ("fc_has_noise_tex", 0), ("fc_has_color_params", 0), ("fc_has_lut_tex", 0), ("fc_has_attachment_0", 1),
+                          ("fc_has_attachment_1", 1), ("fc_has_attachment_2", 0), ("fc_clamp_color", 0), ("fc_extended_range", 0),
+                          ("fc_unbounded_range", 0), ("fc_debug_xr", 0), ("fc_has_premultiply", 0), ("fc_has_hdr_scale", 0),
+                          ("fc_has_edr_factor", 0), ("fc_base_color", 0)] {
+        set(name, DataType::Bool, &[value]);
+    }
+    for (name, value) in [("fc_vertex_layout", 0), ("fc_attachment_count", 2), ("fc_texture_function", 0), ("fc_blend_function", 54),
+                          ("fc_destination_function", 0), ("fc_image_count", 0), ("fc_dest_index", 0), ("fc_dest_count", 1),
+                          ("fc_noise_width", 0)] {
+        set(name, DataType::UChar, &[value]);
+    }
+    for i in 0..2 {
+        for name in ["fc_image_function", "fc_coord_function", "fc_plane_count", "fc_texcoord_count", "fc_memoryless_index", "fc_filter",
+                     "fc_color_inputs"] {
+            set(&format!("{name}{i}"), DataType::UChar, &[0]);
+        }
+        set(&format!("fc_color_opcodes{i}"), DataType::UChar3, &[0, 0, 0]);
+        for name in ["fc_color_opaque", "fc_has_color_trc", "fc_has_color_cube"] {
+            set(&format!("{name}{i}"), DataType::Bool, &[0]);
+        }
+        for plane in ["A", "B", "C"] {
+            set(&format!("fc_has_image_{i}{plane}"), DataType::Bool, &[0]);
+        }
+    }
+    let made = (|| -> Result<(), String> {
+        let vertex = library.new_function_with_name_constant_values(vname, &values).map_err(|e| format!("{vname}: {e:?}"))?;
+        let fragment = library.new_function_with_name_constant_values(fname, &values).map_err(|e| format!("{fname}: {e:?}"))?;
+        let mut inputs = VertexDescriptor::new();
+        for (index, format, offset) in [(0, VertexFormat::Float4, 0), (1, VertexFormat::Float2, 16), (2, VertexFormat::Float2, 24),
+                                        (3, VertexFormat::Half4, 32), (4, VertexFormat::Float, 40)] {
+            inputs.attributes.insert(index, VertexAttributeDescriptor::new(format, offset, 0));
+        }
+        inputs.layouts.insert(0, VertexBufferLayoutDescriptor::new(Some(48)));
+        let mut descriptor = RenderPipelineDescriptor::new(StageSource::Function(vertex.function_descriptor()));
+        descriptor.fragment = Some(StageSource::Function(fragment.function_descriptor()));
+        descriptor.vertex_descriptor = Some(inputs);
+        descriptor.color_attachments[0] = Some(ColorAttachmentDescriptor::new(PixelFormat::BGRA8Unorm));
+        descriptor.color_attachments[1] = Some(ColorAttachmentDescriptor::new(PixelFormat::BGRA8Unorm));
+        device.new_render_pipeline_state(&descriptor, &PipelineOptions::default()).map(|_| ()).map_err(|e| format!("uber pipeline: {e:?}"))
+    })();
+    match made {
+        Ok(()) => run.out.reserved = 1,
+        Err(why) => {
+            run.out.reserved = 2;
+            let n = why.len().min(run.out.message.len() - 1);
+            run.out.message[..n].copy_from_slice(&why.as_bytes()[..n]);
+            run.out.message[n] = 0;
+        }
+    }
+}
