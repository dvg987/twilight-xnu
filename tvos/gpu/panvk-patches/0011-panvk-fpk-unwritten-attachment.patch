+/* PANVK_FPK=bound: a draw may kill the fragments of earlier draws (forward pixel kill, FPK) only if it writes every
+ * color attachment that is bound, which is what this driver used to require of every draw. Without it a draw that
+ * leaves a bound attachment unwritten may kill too. On a Mali-G610 a fragment kills an earlier one only when its draw
+ * writes at least the attachments the earlier fragment's draw writes, so nothing a killed fragment wrote to an
+ * attachment the killer leaves alone is lost (measured for every pair of write sets of two attachments: a heavy draw
+ * writing attachment 1 survives four fills that write attachment 0 only, and those fills kill each other).
+ * Core Animation's passes bind a memoryless, write-masked second color attachment next to the one they fill, and with
+ * the old rule every one of their overdrawn opaque fills was shaded. */
+static inline bool
+panvk_fpk_needs_all_rts_from_env(void)
+{
+   const char *v = getenv("PANVK_FPK");
+
+   return v && !strcmp(v, "bound");
+}
+
 struct panvk_rendering_state {
    VkRenderingFlags flags;
    uint32_t layer_count;
