diff --git a/meson.build b/meson.build
index db0b670..09fe6ec 100644
--- a/meson.build
+++ b/meson.build
@@ -1828,6 +1828,10 @@ if system_has_kms_drm
     required : with_dri2 or with_dri or with_gbm,
     allow_fallback: allow_fallback_for_libdrm,
   )
+elif host_machine.system() == 'darwin' and with_panfrost_vk
+  # Darwin: PanVK talks Panthor ioctls and DRM syncobjs, which we serve from a userspace libdrm shim
+  # (darwin-drm) in front of the Mali IOKit user client. Found through the cross file's pkg-config.
+  dep_libdrm = dependency('libdrm', required : true)
 else
   # We should prevent libdrm from being available when the target doesn't have it to avoid transitive
   # dependencies (such as vk-runtime) linking to it
diff --git a/src/panfrost/vulkan/panvk_physical_device.c b/src/panfrost/vulkan/panvk_physical_device.c
index 6436f8a..e7d380d 100644
--- a/src/panfrost/vulkan/panvk_physical_device.c
+++ b/src/panfrost/vulkan/panvk_physical_device.c
@@ -73,7 +73,12 @@ create_kmod_dev(struct panvk_physical_device *device,
    drmVersionPtr version;
    int fd;
 
+#ifdef __APPLE__
+   /* No device node on Darwin: the libdrm shim hands out an fd bound to the Mali IOKit user client. */
+   fd = drm_darwin_open_render();
+#else
    fd = open(path, O_RDWR | O_CLOEXEC);
+#endif
    if (fd < 0) {
       return panvk_errorf(instance, VK_ERROR_INCOMPATIBLE_DRIVER,
                           "failed to open device %s", path);
@@ -119,6 +124,14 @@ get_drm_device_ids(struct panvk_physical_device *device,
                    const struct panvk_instance *instance,
                    drmDevicePtr drm_device)
 {
+#ifdef __APPLE__
+   /* The shim's "render node" is not a file, there is no st_rdev to report. */
+   device->drm.render_rdev = 0;
+   device->drm.primary_rdev = 0;
+   (void)drm_device;
+   (void)instance;
+   return VK_SUCCESS;
+#else
    struct stat st;
 
    if (stat(drm_device->nodes[DRM_NODE_RENDER], &st)) {
@@ -138,6 +151,7 @@ get_drm_device_ids(struct panvk_physical_device *device,
    }
 
    return VK_SUCCESS;
+#endif
 }
 
