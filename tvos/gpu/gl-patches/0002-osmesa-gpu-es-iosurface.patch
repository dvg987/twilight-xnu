@@ -25,6 +25,115 @@
 #include "target-helpers/inline_debug_helper.h"
 
 #include "sw/null/null_sw_winsys.h"
+#include "drm-uapi/drm_fourcc.h"
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+
+#include "frontend/winsys_handle.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+
+#ifdef GALLIUM_PANFROST
+/*
+ * Darwin (tvOS on the Mi Box S Gen 3): the GPU's driver is gallium panfrost (Mali-G310, Valhall v10, CSF), and its "DRM device" is
+ * MaliMetal's darwin-drm, a libdrm stand-in that serves the Panthor ioctls with calls of the kernel's MaliService IOKit user client
+ * (hakios.mali_uapi.h). drm_darwin_open_render() hands out the descriptor (a /dev/null that stands for the one connection a process has).
+ */
+#include <errno.h>
+#include <IOSurface/IOSurfaceRef.h>
+#include "panfrost/drm/panfrost_drm_public.h"
+#include "util/driconf.h"
+#include "util/xmlconfig.h"
+#include <xf86drm.h>
+
+static const driOptionDescription panfrost_options[] = {
+#include "panfrost/driinfo_panfrost.h"
+};
+
+static struct pipe_screen *gpu_screen;
+
+/* The GPU's screen; NULL: no MaliService (QEMU, a kernel without mali=), or OSMESA_SOFTWARE=1. */
+static struct pipe_screen *
+osmesa_create_gpu_screen(void)
+{
+   static driOptionCache info, cache;
+   static struct pipe_screen_config config;
+   struct pipe_screen *screen;
+   int fd;
+
+   if (debug_get_bool_option("OSMESA_SOFTWARE", false))
+      return NULL;
+   fd = drm_darwin_open_render();
+   if (fd < 0) {
+      if (debug_get_bool_option("OSMESA_DEBUG_GPU", false))
+         fprintf(stderr, "osmesa: no Mali (MaliService): %s; software rendering\n", strerror(errno));
+      return NULL;
+   }
+   driParseOptionInfo(&info, panfrost_options, ARRAY_SIZE(panfrost_options));
+   driParseConfigFiles(&cache, &info, 0, "panfrost", NULL, NULL, NULL, 0, NULL, 0);
+   config.options = &cache;
+   config.options_info = &info;
+   /* (the winsys takes a duplicate of the descriptor for itself) */
+   screen = panfrost_drm_screen_create(fd, &config);
+   close(fd);
+   if (!screen) {
+      fprintf(stderr, "osmesa: MaliService is there but panfrost made no screen of it; software rendering\n");
+      return NULL;
+   }
+   gpu_screen = screen;
+   return debug_screen_wrap(screen);
+}
+#endif
+
+
+struct pipe_resource *
+osmesa_surface_resource(struct pipe_screen *screen, uint32_t surface);
+
+/*
+ * The memory of an IOSurface as a texture, to draw into and to draw with: there is no EGL here, so what
+ * glEGLImageTargetTexture2DOES is given as an image is the ID of an IOSurface (frontends/osmesa/osmesa.c). The kernel makes a
+ * buffer object of the surface's pages (MALI_BO_CREATE_HOST, through panfrost_bo_import(): pan_kmod_bo_import_iosurface()).
+ * NULL: the screen is not the GPU's, or the surface is not one plane of 32-bit pixels, blue first, in rows the GPU can address.
+ */
+struct pipe_resource *
+osmesa_surface_resource(struct pipe_screen *screen, uint32_t surface)
+{
+#ifdef GALLIUM_PANFROST
+   struct pipe_resource templ = {
+      .target = PIPE_TEXTURE_2D,
+      .format = PIPE_FORMAT_B8G8R8A8_UNORM,
+      .depth0 = 1,
+      .array_size = 1,
+      .bind = PIPE_BIND_SAMPLER_VIEW | PIPE_BIND_RENDER_TARGET,
+   };
+   struct winsys_handle handle = { .type = WINSYS_HANDLE_TYPE_FD, .modifier = DRM_FORMAT_MOD_INVALID };
+   IOSurfaceRef s;
+
+   if (!gpu_screen || !screen)
+      return NULL;
+   s = IOSurfaceLookup(surface);
+   if (!s)
+      return NULL;
+   bool ok = IOSurfaceGetPixelFormat(s) == 0x42475241 /* 'BGRA' */ && IOSurfaceGetPlaneCount(s) == 0 &&
+             IOSurfaceGetBytesPerElement(s) == 4;
+   templ.width0 = IOSurfaceGetWidth(s);
+   templ.height0 = IOSurfaceGetHeight(s);
+   handle.stride = IOSurfaceGetBytesPerRow(s);
+   CFRelease(s);
+   if (!ok)
+      return NULL;
+   /* (the surface comes in as Linux's buffers come in by file descriptor: its ID in place of the descriptor) */
+   handle.handle = surface;
+   handle.offset = 0;
+   return screen->resource_from_handle(screen, &templ, &handle, 0);
+#else
+   (void)screen;
+   (void)surface;
+   return NULL;
+#endif
+}
 
 
