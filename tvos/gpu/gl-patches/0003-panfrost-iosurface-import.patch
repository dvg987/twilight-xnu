+#ifdef __APPLE__
+/* Clean AND invalidate to the point of coherency, DC CIVAC by line. Not libSystem's sys_dcache_flush(), which only cleans on this
+ * system (MaliMetal measured stale reads after GPU writes with it: NativeBridgeMetalFrontend.mm). EL0 may: SCTLR_EL1.UCI; the line
+ * size from CTR_EL0 (SCTLR_EL1.UCT). */
+static void
+pan_darwin_dcache_civac(void *start, size_t length)
+{
+   uint64_t ctr;
+   __asm__ volatile("mrs %0, ctr_el0" : "=r"(ctr));
+   const size_t line = 4u << ((ctr >> 16) & 0xf);
+   for (uintptr_t p = (uintptr_t)start & ~(uintptr_t)(line - 1);
+        p < (uintptr_t)start + length; p += line)
+      __asm__ volatile("dc civac, %0" : : "r"(p) : "memory");
+   __asm__ volatile("dsb sy" : : : "memory");
+}
+
+struct pan_kmod_bo *
+pan_kmod_bo_import_iosurface(struct pan_kmod_dev *dev, uint32_t surface_id)
+{
+   IOSurfaceRef surface = IOSurfaceLookup(surface_id);
+   struct pan_kmod_bo *bo = NULL;
+   struct pan_kmod_bo **slot;
+   uint32_t handle;
+
+   if (!surface)
+      return NULL;
+
+   void *base = IOSurfaceGetBaseAddress(surface);
+   size_t size = ALIGN_POT(IOSurfaceGetAllocSize(surface), 4096);
+   if (!base || ((uintptr_t)base & 4095) || !size) {
+      mesa_loge("IOSurface %u: memory at %p, %zu bytes: not whole pages", surface_id, base, size);
+      goto err_release;
+   }
+
+   /* The GPU is not coherent with this processor's caches, and the surface's mapping here may be cached: what this process wrote
+    * goes to memory before the GPU reads it, and no line is left that could be written back over what the GPU draws. */
+   pan_darwin_dcache_civac(base, size);
+
+   simple_mtx_lock(&dev->handle_to_bo.lock);
+   if (drm_darwin_bo_create_host(dev->fd, base, size, &handle)) {
+      mesa_loge("IOSurface %u: the kernel made no buffer object of it (err=%d)", surface_id, errno);
+      goto err_unlock;
+   }
+
+   slot = util_sparse_array_get(&dev->handle_to_bo.array, handle);
+   if (!slot || *slot)
+      goto err_close_handle;
+
+   bo = dev->ops->bo_import(dev, handle, size, 0);
+   if (!bo)
+      goto err_close_handle;
+
+   bo->darwin_surface = surface;
+   *slot = bo;
+   simple_mtx_unlock(&dev->handle_to_bo.lock);
+   return bo;
+
+err_close_handle:
+   drmCloseBufferHandle(dev->fd, handle);
+err_unlock:
+   simple_mtx_unlock(&dev->handle_to_bo.lock);
+err_release:
+   CFRelease(surface);
+   return NULL;
+}
+#endif
+
